// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id                           String     @id @default(cuid())
  name                         String
  age                          Int
  actionsAmount                Float      @default(0)
  obligationsAmount            Float      @default(0)
  immobilierAmount             Float      @default(0)
  scpiAmount                   Float      @default(0)
  liquiditesAmount             Float      @default(0)
  privateEquityAmount          Float      @default(0)
  outilProfessionnelAmount     Float      @default(0)
  professionalToolMainIncome   Boolean    @default(false)
  matieresPremieresAmount      Float      @default(0)
  autresAmount                 Float      @default(0)
  actionsIndicielPct           Float      @default(100)
  actionsDefensifPct           Float      @default(0)
  actionsCroissancePct         Float      @default(0)
  riskProfile                  String?
  notes                        String?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt
  properties                   Property[]
  savedScenarios               SavedScenario[]
}

model Property {
  id                  String   @id @default(cuid())
  name                String
  currentValue        Float
  monthlyRent         Float?
  department          String?
  arrondissement      Int?
  communeCode         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loans               Loan[]
}

model Loan {
  id               String    @id @default(cuid())
  label            String?
  originalAmount   Float
  remainingAmount  Float
  rate             Float
  rateType         String    @default("fixed")
  amortizationType String    @default("amortissable")
  residualAmount   Float?
  termYears        Int
  startDate        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model SavedScenario {
  id                       String   @id @default(cuid())
  name                     String
  marketShockPct           Float
  oatRateChangePts         Float
  scpiShockPct             Float
  inflationPct             Float
  inflationYears           Int
  vacancyPropertyId        String?
  vacancyMonths            Int
  obligationsDurationYears Float
  peIlliquidityDiscountPct Float
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  clientId                 String
  client                   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
