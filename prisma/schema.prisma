// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /** "admin" | "advisor", validated app-side (src/lib/auth/roles.ts). */
  role         String   @default("advisor")
  createdAt    DateTime @default(now())
  clients      Client[]
}

model Client {
  id                            String              @id @default(cuid())
  name                          String
  age                           Int
  actionsAmount                 Float               @default(0)
  obligationsAmount             Float               @default(0)
  immobilierAmount              Float               @default(0)
  scpiAmount                    Float               @default(0)
  liquiditesAmount              Float               @default(0)
  privateEquityAmount           Float               @default(0)
  outilProfessionnelAmount      Float               @default(0)
  professionalToolMainIncome    Boolean             @default(false)
  matieresPremieresAmount       Float               @default(0)
  matieresPremieresGoldAmount   Float               @default(0)
  matieresPremieresSilverAmount Float               @default(0)
  autresAmount                  Float               @default(0)
  riskProfile                   String?
  notes                         String?
  monthlySavingsAmount          Float?
  wealthGoalAmount              Float?
  wealthGoalAge                 Int?
  wealthGoalInflationPct        Float?
  /** Annual fees per poste for the wealth-goal simulation; null = default
   * (DEFAULT_ANNUAL_FEES_PCT). */
  feesActionsPct                Float?
  feesObligationsPct            Float?
  feesScpiPct                   Float?
  feesPrivateEquityPct          Float?
  feesImmobilierPct             Float?
  /** Flux annuels pour l'objectif patrimonial (lot 5) : revenus nets perçus
   * imposables en France, revenus nets de source étrangère déjà imposés,
   * dépenses de train de vie. null = non renseigné. */
  incomeFranceAnnual            Float?
  incomeForeignAnnual           Float?
  livingExpensesAnnual          Float?
  /** true = l'épargne annuelle est calculée à partir des flux (revenus,
   * loyers, dépenses, mensualités, impôt) ; false = saisie manuelle de
   * monthlySavingsAmount, comportement historique. */
  savingsFromFlows              Boolean             @default(false)
  maritalStatus                 String?
  spouseName                    String?
  spouseImmobilierAmount        Float?
  spouseScpiAmount              Float?
  spouseDebtAmount              Float?
  minorChildrenCount            Int?
  adultChildrenCount            Int?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  /** Nullable at the schema level only so the migration stays additive;
   * the app always sets it, and an orphan is visible to admins alone. */
  ownerId                       String?
  owner                         User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  properties                    Property[]
  savedScenarios                SavedScenario[]
  wrapperAllocations            WrapperAllocation[]
  actionsIndexAllocations       ActionsIndexAllocation[]
  wealthGoalProposal            WealthGoalProposal?

  @@index([ownerId])
}

model Property {
  id                 String    @id @default(cuid())
  name               String
  currentValue       Float
  isPrimaryResidence Boolean   @default(false)
  monthlyRent        Float?
  /** Quote-part détenue par le client, en %. Toute la chaîne de calcul
   * (valeur, loyers, dette sauf prêt porté à 100 %, IFI, stress test,
   * Monte Carlo, flux) s'applique à cette quote-part. */
  ownershipSharePct  Float     @default(100)
  /** "direct" | "indivision" | "sci_ir" | "sci_is" | "nue_propriete" |
   * "usufruit", validé côté app (src/lib/property/ownership.ts). */
  holdingMode        String    @default("direct")
  acquisitionPrice   Float?
  acquisitionDate    DateTime?
  department         String?
  arrondissement     Int?
  communeCode        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loans              Loan[]
}

model Loan {
  id               String    @id @default(cuid())
  label            String?
  originalAmount   Float
  remainingAmount  Float
  rate             Float
  rateType         String    @default("fixed")
  amortizationType String    @default("amortissable")
  residualAmount   Float?
  /** true = le client porte 100 % du prêt même si le bien est détenu en
   * quote-part ; false = la dette suit la quote-part du bien. */
  borneFullyByClient Boolean  @default(false)
  termYears        Int
  startDate        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model WrapperAllocation {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category  String
  wrapper   String
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, category, wrapper])
}

/** Replaces the old "Indiciel large / Défensif / Croissance" style-based
 * profile: the Actions bucket's sub-allocation is now directly a % breakdown
 * across the real indices in referenceIndices.ts (e.g. 40% CAC 40, 60%
 * Nasdaq), so scenario shocks use each index's own real historical move
 * instead of a beta-multiplier fiction. No row for a client = 100% MSCI
 * World (the implicit default), same "no row = not detailed" convention as
 * WrapperAllocation. */
model ActionsIndexAllocation {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  index      String
  percentage Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clientId, index])
}

model SavedScenario {
  id                       String   @id @default(cuid())
  name                     String
  marketShockPct           Float
  oatRateChangePts         Float
  /** null = derived from the rate (zone sensitivity / duration), see
   * ScenarioParams. Nullable so the migration stays additive. */
  realEstateShockPct       Float?
  obligationsShockPct      Float?
  scpiShockPct             Float
  inflationPct             Float
  inflationYears           Int
  vacancyPropertyId        String?
  vacancyMonths            Int
  obligationsDurationYears Float
  peIlliquidityDiscountPct Float
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  clientId                 String
  client                   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Allocation proposée par le conseiller pour la comparaison avant / après de
/// l'objectif patrimonial : une seule par client, mêmes six postes financiers
/// que l'allocation actuelle (l'immobilier, les prêts, l'entreprise et Autres
/// ne bougent pas). Le total doit égaler la poche financière actuelle.
model WealthGoalProposal {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  client                  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actionsAmount           Float    @default(0)
  obligationsAmount       Float    @default(0)
  scpiAmount              Float    @default(0)
  liquiditesAmount        Float    @default(0)
  privateEquityAmount     Float    @default(0)
  matieresPremieresAmount Float    @default(0)
  /// Répartition par indice actions, { [ReferenceIndex]: pourcentage }, total 100.
  actionsIndexBreakdown   Json
  feesActionsPct          Float
  feesObligationsPct      Float
  feesScpiPct             Float
  feesPrivateEquityPct    Float
  feesImmobilierPct       Float
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
