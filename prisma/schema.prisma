// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id                           String     @id @default(cuid())
  name                         String
  age                          Int
  actionsAmount                Float      @default(0)
  obligationsAmount            Float      @default(0)
  immobilierAmount             Float      @default(0)
  scpiAmount                   Float      @default(0)
  liquiditesAmount             Float      @default(0)
  privateEquityAmount          Float      @default(0)
  outilProfessionnelAmount     Float      @default(0)
  professionalToolMainIncome   Boolean    @default(false)
  matieresPremieresAmount      Float      @default(0)
  autresAmount                 Float      @default(0)
  actionsIndicielPct           Float      @default(100)
  actionsDefensifPct           Float      @default(0)
  actionsCroissancePct         Float      @default(0)
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt
  properties                   Property[]
}

model Property {
  id                  String   @id @default(cuid())
  name                String
  currentValue        Float
  monthlyRent         Float?
  remainingLoanAmount Float    @default(0)
  loanRate            Float    @default(0)
  rateType            String   @default("fixed")
  department          String?
  arrondissement      Int?
  communeCode         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
